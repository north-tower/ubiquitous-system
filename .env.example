PORT=3000
NODE_ENV=development

# PostgreSQL (docker compose service: postgres). Host 5433 avoids a local Windows Postgres on 5432.
DATABASE_URL=postgres://techfind:techfind@localhost:5433/techfind_whatsapp

# Redis is provisioned for later outbound queues (BullMQ can wait)
REDIS_URL=redis://localhost:6379

# Meta WhatsApp Cloud API
META_VERIFY_TOKEN=replace-with-meta-verify-token
META_ACCESS_TOKEN=replace-with-meta-access-token
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v21.0

# Twilio WhatsApp (sandbox or a Twilio-hosted number). A number cannot be on both Meta and Twilio.
# Sandbox: join first by sending the join code to the Twilio WhatsApp number, then set the inbound
# webhook to https://<your-host>/webhooks/twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Twilio is the default provider. Set to meta to prefer Cloud API instead.
WHATSAPP_PRIMARY_CHANNEL=twilio
# Replies stay on the inbound channel unless this is true (then the other provider is tried on send failure).
WHATSAPP_SEND_FAILOVER=false
# WHATSAPP_SKIP_SEND=true

# OpenAI (Phase 4 orchestrator). Never commit a real key.
# Wrap the key in double quotes so # and $ in the key are not treated as comments/vars.
OPENAI_API_KEY=
# gpt-4o-mini supports Structured Outputs. gpt-4-turbo works too (JSON object fallback).
OPENAI_MODEL=gpt-4o-mini

TYPEORM_MIGRATIONS_RUN=true
TYPEORM_LOGGING=false

# Render Postgres requires SSL. Local Docker Postgres does not.
# DATABASE_SSL=true
# Also auto-enabled when DATABASE_URL contains sslmode=require.

# Phase 6 internal dashboard (STUB HTTP Basic Auth — replace before real staff access)
DASHBOARD_BASIC_AUTH_USER=techfind
DASHBOARD_BASIC_AUTH_PASSWORD=replace-me-before-staff-access
DASHBOARD_TIMEZONE=Africa/Nairobi
CORS_ORIGIN=http://localhost:3001

# Docker (this repo only — Nest API + postgres + redis, no Next.js UI)
#   docker compose up --build
# API: http://localhost:3000  Postgres host port: 5433
# Compose overrides DATABASE_URL to postgres:5432 on the docker network.
