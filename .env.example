PORT=3000
# Host port published by Docker (container still listens on 3000)
API_PORT=5600
NODE_ENV=development

# PostgreSQL (docker compose service: postgres). Host 5433 avoids a local Windows Postgres on 5432.
DATABASE_URL=postgres://techfind:techfind@localhost:5433/techfind_whatsapp

# Redis is provisioned for later outbound queues (BullMQ can wait)
REDIS_URL=redis://localhost:6379

# Meta WhatsApp Cloud API
META_VERIFY_TOKEN=replace-with-meta-verify-token
META_ACCESS_TOKEN=replace-with-meta-access-token
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v21.0

# Twilio WhatsApp (sandbox or a Twilio-hosted number). A number cannot be on both Meta and Twilio.
# Sandbox: join first by sending the join code to the Twilio WhatsApp number, then set the inbound
# webhook to https://<your-host>/webhooks/twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Baileys (WhatsApp Web socket) instead of Twilio. The oldest tenant keeps the
# login in BAILEYS_AUTH_DIR. Each other tenant gets baileys-auth/<tenantId>.
# Run only one process on the same login.
BAILEYS_ENABLED=true
# Path inside the API process (Docker WORKDIR is /app — use baileys-auth, not ../ paths).
BAILEYS_AUTH_DIR=baileys-auth
# Host path bind-mounted to /app/baileys-auth in docker compose (copy baileys-test/auth_info here once).
# BAILEYS_AUTH_HOST_PATH=./baileys-auth
# If pairing fails with EACCES before rebuild: sudo chown -R 1001:1001 ./baileys-auth

# baileys, twilio, or meta. Replies stay on the inbound channel.
WHATSAPP_PRIMARY_CHANNEL=baileys
# enquiry_intake Twilio Content SIDs (HX…). Leave blank → numbered text fallback on all channels.
# Step → type mapping: src/enquiry-flow/enquiry-twilio-content.ts
# list-picker: in-session only, no WhatsApp approval; ListId must match enquiry-options ids.
# quick-reply: ≤3 buttons in-session; map ButtonPayload in parse-twilio when wired.
# whatsapp/flows: multi-select services; requires Flow publish + InteractiveData handling.
TWILIO_EVENT_TYPE_CONTENT_SID=
TWILIO_ENQUIRY_RETURNING_CONTENT_SID=
# List fallback (single tap). Ignored when FLOW SID is set.
TWILIO_ENQUIRY_SERVICES_CONTENT_SID=
# Multi-select Flow (preferred). See docs/TWILIO_ENQUIRY_SERVICES_FLOW.md
TWILIO_ENQUIRY_SERVICES_FLOW_CONTENT_SID=
TWILIO_ENQUIRY_BUDGET_CONTENT_SID=
TWILIO_ENQUIRY_BUDGET_CONFIRM_CONTENT_SID=
TWILIO_ENQUIRY_PHONE_CONTENT_SID=
# Confirm template body should include {{1}} for the enquiry summary.
TWILIO_ENQUIRY_CONFIRM_CONTENT_SID=
TWILIO_ENQUIRY_EDIT_FIELD_CONTENT_SID=
# Replies stay on the inbound channel unless this is true (then the other provider is tried on send failure).
WHATSAPP_SEND_FAILOVER=false
# WHATSAPP_SKIP_SEND=true

# OpenAI (Phase 4 orchestrator). Never commit a real key.
# Wrap the key in double quotes so # and $ in the key are not treated as comments/vars.
OPENAI_API_KEY=
# gpt-4o-mini supports Structured Outputs. gpt-4-turbo works too (JSON object fallback).
OPENAI_MODEL=gpt-4o-mini

TYPEORM_MIGRATIONS_RUN=true
TYPEORM_LOGGING=false

# Render Postgres requires SSL. Local Docker Postgres does not.
# DATABASE_SSL=true
# Also auto-enabled when DATABASE_URL contains sslmode=require.

# Phase 6 internal dashboard (STUB HTTP Basic Auth — replace before real staff access)
DASHBOARD_BASIC_AUTH_USER=techfind
DASHBOARD_BASIC_AUTH_PASSWORD=replace-me-before-staff-access
DASHBOARD_TIMEZONE=Africa/Nairobi
CORS_ORIGIN=http://localhost:3001
# Public WhatsApp UI (tenant portal links in onboarding email)
TENANT_PORTAL_APP_URL=http://localhost:3001

# Email (Mailgun — same pattern as Divine Budget ops). Required in .env for Docker:
# docker-compose.yml passes these into the api service (UI shows EMAIL_NOT_CONFIGURED if any are missing).
EMAIL_PROVIDER=mailgun
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
MAILGUN_DOMAIN=
# MAILGUN_URL=https://api.eu.mailgun.net

# Techfind pilot menu (techfind_demo flow)
# TECHFIND_WEBSITE_URL=https://techfindconsulting.africa

# Divine Budget ops app (enquiry intake flow). Leave blank to keep this
# process on the Techfind demo. Set TENANT_FLOW=enquiry_intake to route the
# seeded Twilio/Meta tenant into the real customer conversation.
# DIVINE_BUDGET_BASE_URL=http://localhost:3000
# DIVINE_BUDGET_API_KEY=
# TENANT_FLOW=enquiry_intake

# Insightful POS (pos_ops tenant flow). Base URL is the Supabase Edge Function:
# https://<project>.supabase.co/functions/v1/whatsapp-ops
# INSIGHTFUL_POS_BASE_URL=
# INSIGHTFUL_POS_API_KEY=
# TENANT_FLOW=pos_ops

# Docker (this repo only — Nest API + postgres + redis, no Next.js UI)
#   docker compose up --build
# API: http://127.0.0.1:5600  Postgres host port: 5433
# Compose overrides DATABASE_URL to postgres:5432 on the docker network.
# Email + Baileys vars must be set in .env; compose passes them into the api service.
